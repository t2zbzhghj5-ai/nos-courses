rules_version = '2';

// Nos courses : seuls les deux comptes de la maison lisent et modifient la liste.
service cloud.firestore {
  match /databases/{database}/documents {

    function estDeLaMaison() {
      return request.auth != null
        && request.auth.uid in [
          'g7TbEjZbO7eKPCCf31BfUJFSaZX2',
          '4lBDjdccJ6Tquw4YHGAmsJWI0Ey2'
        ];
    }

    match /{document=**} {
      allow read, write: if estDeLaMaison();
    }
  }
}
